PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=autoventas_app
DB_PASSWORD=
DB_NAME=autoventas_gt

# Secreto para firmar los JWT (use una cadena larga y aleatoria)
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:8080

# Descuento máximo (%) que un Vendedor puede aplicar sin aprobación de Gerente
DESCUENTO_APROBACION_PCT=10

# Contraseñas iniciales de los usuarios de demostración (solo para scripts/seed.js)
ADMIN_PASSWORD=
GERENTE_PASSWORD=
VENDEDOR_PASSWORD=
